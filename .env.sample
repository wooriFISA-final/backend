DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_dbname

# JWT settings
# 난수의 기반이 될 값 아무거나
JWT_SECRET_KEY=a-zA-Z!@^
JWT_ALGORITHM=HS256

# host
BACKEND_URI=localhost

# CORS settings (쉼표로 구분하여 여러 origin 추가)
CORS_ORIGINS=http://woorizip.info,https://woorizip.info,https://www.woorizip.info,http://localhost:3000,http://localhost:5173